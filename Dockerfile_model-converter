# ci: standalone
# ci: watch=model-converter/**

FROM python:3.11-bookworm

ARG DOCKER_HELPER_VERSION=2.2.0-rc.4
ARG DOCKER_HELPER_SHA256=27b6c947e907a02caeb0139aabf8706c4dedb5f42e6327a982a3bb0bf979691c

ARG BAZELISK_VERSION=1.18.0
ARG BAZEL_VERSION=7.4.1

USER root

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        adb \
        bash \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        file \
        git \
        jq \
        less \
        libnotify-bin \
        llvm \
        ninja-build \
        openjdk-17-jdk \
        openssh-client \
        patchelf \
        procps \
        ripgrep \
        tar \
        tree \
        unzip \
        wget \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

#
# Bazelisk. Keep Bazel aligned with LiteRT's current hermetic build environment.
#
RUN set -eux; \
    curl -fsSL --retry 3 \
        "https://github.com/bazelbuild/bazelisk/releases/download/v${BAZELISK_VERSION}/bazelisk-linux-amd64" \
        -o /usr/local/bin/bazel; \
    chmod 0755 /usr/local/bin/bazel; \
    USE_BAZEL_VERSION="${BAZEL_VERSION}" bazel --version

ENV USE_BAZEL_VERSION=${BAZEL_VERSION}

#
# OpenCode.
#
RUN curl -fsSL https://opencode.ai/install | bash \
    && install -m 0755 \
        /root/.opencode/bin/opencode \
        /usr/local/bin/opencode \
    && rm -rf /root/.opencode

#
# Runtime user.
#
RUN groupadd --gid 1000 opencode \
    && useradd \
        --uid 1000 \
        --gid 1000 \
        --create-home \
        --shell /bin/bash \
        opencode \
    && install -d \
        -m 0700 \
        -o opencode \
        -g opencode \
        /home/opencode/.ssh \
    && install -d \
        -m 0755 \
        /etc/opencode \
        /workspace \
        /home/opencode/.cache \
        /home/opencode/.config \
        /home/opencode/.local/share/opencode

#
# docker-helper.
#
RUN set -eux; \
    bundle="docker-helper-${DOCKER_HELPER_VERSION}-linux-amd64"; \
    archive="/tmp/${bundle}.tar.gz"; \
    \
    curl -fsSL --retry 3 \
        "https://github.com/kivarun/docker-helper/releases/download/v${DOCKER_HELPER_VERSION}/${bundle}.tar.gz" \
        -o "${archive}"; \
    \
    echo "${DOCKER_HELPER_SHA256}  ${archive}" | sha256sum -c -; \
    \
    tar -xzf "${archive}" -C /tmp; \
    \
    install -m 0755 \
        "/tmp/${bundle}/docker-helper" \
        /usr/local/bin/docker-helper; \
    \
    install -d \
        -m 0755 \
        -o opencode \
        -g opencode \
        /home/opencode/.claude/skills/docker-helper; \
    \
    install \
        -m 0644 \
        -o opencode \
        -g opencode \
        "/tmp/${bundle}/skills/docker-helper/SKILL.md" \
        /home/opencode/.claude/skills/docker-helper/SKILL.md; \
    \
    test "$(docker-helper version)" = "${DOCKER_HELPER_VERSION}"; \
    \
    rm -rf "${archive}" "/tmp/${bundle}"

#
# Conversion environment.
#
RUN python -m venv /opt/model-converter \
    && /opt/model-converter/bin/pip install --upgrade pip setuptools wheel \
    && /opt/model-converter/bin/pip install \
        --pre \
        litert-torch-nightly \
        ai-edge-litert \
        litert-cli-nightly \
        transformers \
        huggingface-hub \
        sentencepiece

ENV VIRTUAL_ENV=/opt/model-converter
ENV PATH="/opt/model-converter/bin:/usr/local/bin:${PATH}"

COPY model-converter/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh \
    && chown -R opencode:opencode \
        /home/opencode \
        /workspace \
    && install -d \
        /tmp/opencode

ENV HOME=/home/opencode

WORKDIR /workspace

USER opencode

RUN set -eux; \
    python --version; \
    pip --version; \
    adb version; \
    java -version; \
    bazel --version; \
    python -c 'import torch; print("torch", torch.__version__)'; \
    python -c 'import litert_torch; print("litert_torch ok")'

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
