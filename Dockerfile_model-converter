# ci: standalone
# ci: watch=model-converter/**

FROM python:3.11-bookworm

ARG DOCKER_HELPER_VERSION=2.2.0-rc.5
ARG DOCKER_HELPER_SHA256=4fe4fdaf774b47c1fb831dc45ae187161883084d995110dadea6e6c159f93766

ARG BAZELISK_VERSION=1.18.0
ARG BAZEL_VERSION=7.4.1

#
# Conversion toolchain.
#
# These are the exact versions used by the first successful generic
# HF -> LiteRT-LM -> BoxProbe conversion/UAT.
#
ARG PIP_VERSION=26.2.1
ARG LITERT_TORCH_VERSION=0.10.0.dev20260909
ARG LITERT_CLI_VERSION=0.3.0.dev20260914
ARG LITERT_LM_BUILDER_VERSION=0.17.1
ARG AI_EDGE_LITERT_VERSION=2.2.0

USER root

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        adb \
        bash \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        file \
        git \
        jq \
        less \
        libnotify-bin \
        llvm \
        ninja-build \
        openjdk-17-jdk \
        openssh-client \
        patchelf \
        procps \
        ripgrep \
        tar \
        tree \
        unzip \
        wget \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

#
# Bazelisk.
#
# Keep Bazel aligned with the currently validated converter environment.
#
RUN set -eux; \
    curl -fsSL --retry 3 \
        "https://github.com/bazelbuild/bazelisk/releases/download/v${BAZELISK_VERSION}/bazelisk-linux-amd64" \
        -o /usr/local/bin/bazel; \
    chmod 0755 /usr/local/bin/bazel; \
    USE_BAZEL_VERSION="${BAZEL_VERSION}" bazel --version

ENV USE_BAZEL_VERSION=${BAZEL_VERSION}

#
# OpenCode.
#
RUN curl -fsSL https://opencode.ai/install | bash \
    && install -m 0755 \
        /root/.opencode/bin/opencode \
        /usr/local/bin/opencode \
    && rm -rf /root/.opencode

#
# Runtime user.
#
RUN groupadd --gid 1000 opencode \
    && useradd \
        --uid 1000 \
        --gid 1000 \
        --create-home \
        --shell /bin/bash \
        opencode \
    && install -d \
        -m 0755 \
        /etc/opencode \
    && install -d \
        -m 0700 \
        -o opencode \
        -g opencode \
        /home/opencode/.ssh \
    && install -d \
        -m 0755 \
        -o opencode \
        -g opencode \
        /workspace \
        /home/opencode/.cache \
        /home/opencode/.config \
        /home/opencode/.local \
        /home/opencode/.local/share \
        /home/opencode/.local/share/opencode \
        /home/opencode/.local/state \
    && install -d \
        -m 0700 \
        -o opencode \
        -g opencode \
        /tmp/opencode

#
# docker-helper.
#
RUN set -eux; \
    bundle="docker-helper-${DOCKER_HELPER_VERSION}-linux-amd64"; \
    archive="/tmp/${bundle}.tar.gz"; \
    \
    curl -fsSL --retry 3 \
        "https://github.com/kivarun/docker-helper/releases/download/v${DOCKER_HELPER_VERSION}/${bundle}.tar.gz" \
        -o "${archive}"; \
    \
    echo "${DOCKER_HELPER_SHA256}  ${archive}" | sha256sum -c -; \
    \
    tar -xzf "${archive}" -C /tmp; \
    \
    install -m 0755 \
        "/tmp/${bundle}/docker-helper" \
        /usr/local/bin/docker-helper; \
    \
    install -d \
        -m 0755 \
        -o opencode \
        -g opencode \
        /home/opencode/.claude/skills/docker-helper; \
    \
    install \
        -m 0644 \
        -o opencode \
        -g opencode \
        "/tmp/${bundle}/skills/docker-helper/SKILL.md" \
        /home/opencode/.claude/skills/docker-helper/SKILL.md; \
    \
    test "$(docker-helper version)" = "${DOCKER_HELPER_VERSION}"; \
    \
    rm -rf "${archive}" "/tmp/${bundle}"

#
# Conversion environment.
#
RUN python -m venv /opt/model-converter \
    && /opt/model-converter/bin/python -m pip install \
        "pip==${PIP_VERSION}" \
    && /opt/model-converter/bin/python -m pip install \
        "litert-torch-nightly==${LITERT_TORCH_VERSION}" \
        "litert-cli-nightly==${LITERT_CLI_VERSION}" \
        "litert-lm-builder==${LITERT_LM_BUILDER_VERSION}" \
        "ai-edge-litert==${AI_EDGE_LITERT_VERSION}" \
        transformers \
        huggingface-hub \
        sentencepiece \
    && /opt/model-converter/bin/python -m pip check

ENV VIRTUAL_ENV=/opt/model-converter
ENV PATH="/opt/model-converter/bin:/usr/local/bin:${PATH}"

#
# LiteRT Torch compatibility patch.
#
# The validated export_hf path currently ignores
# ExportConfig.output_logits_on_prefill=False and unconditionally exports
# logits from prefill signatures.
#
# LiteRT-LM 0.12 expects prefill outputs to contain KV cache tensors only.
#
# patch-litert-torch.py MUST be the exact fail-closed patch validated during
# UAT. It must refuse to modify an unexpected upstream source layout.
#
COPY model-converter/patch-litert-torch.py /tmp/patch-litert-torch.py

RUN set -eux; \
    /opt/model-converter/bin/python /tmp/patch-litert-torch.py; \
    rm -f /tmp/patch-litert-torch.py

#
# Post-conversion contract verifier.
#
# For generic LLM artifacts it verifies:
#   - the LiteRT-LM container is readable;
#   - prefill signatures expose KV-cache outputs only;
#   - decode exposes logits;
#   - incompatible artifacts fail closed before device UAT.
#
COPY model-converter/verify-litertlm.py /usr/local/bin/verify-litertlm

RUN chmod 0755 /usr/local/bin/verify-litertlm \
    && /opt/model-converter/bin/python -m py_compile \
        /usr/local/bin/verify-litertlm

#
# OpenCode entrypoint.
#
COPY model-converter/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh \
    && chown -R opencode:opencode \
        /home/opencode \
        /workspace \
        /tmp/opencode

ENV HOME=/home/opencode

WORKDIR /workspace

USER opencode

#
# Build-time smoke test.
#
RUN set -eux; \
    python --version; \
    pip --version; \
    adb version; \
    java -version; \
    bazel --version; \
    docker-helper version; \
    litert --help >/dev/null; \
    litert-lm-peek --help >/dev/null; \
    python -c 'import torch; print("torch", torch.__version__)'; \
    python -c 'import litert_torch; print("litert_torch ok")'; \
    python -c 'import importlib.metadata as m; print("litert-torch-nightly", m.version("litert-torch-nightly")); print("litert-cli-nightly", m.version("litert-cli-nightly")); print("litert-lm-builder", m.version("litert-lm-builder")); print("ai-edge-litert", m.version("ai-edge-litert"))'; \
    pip check

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
