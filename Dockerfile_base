FROM ghcr.io/anomalyco/opencode:latest

ARG DOCKER_HELPER_VERSION=2.1.1
ARG DOCKER_HELPER_SHA256=d38b8c775e8e772bbe49c447477b237f4ffaeef24c25ac27074e53efd067712b

USER root

RUN addgroup -g 1000 opencode \
    && adduser -D -u 1000 -G opencode opencode

RUN install -d \
      -m 0755 \
      -o opencode \
      -g opencode \
      /home/opencode/.config/opencode \
      /home/opencode/.local \
      /home/opencode/.local/share \
      /home/opencode/.local/share/opencode \
      /home/opencode/.local/state \
      /home/opencode/.cache

USER root

RUN echo '@edge-testing https://dl-cdn.alpinelinux.org/alpine/edge/testing' \
      >> /etc/apk/repositories \
    && apk add --no-cache \
        bash \
        curl \
        fd \
        git \
        jq \
        less \
        openssh-client \
        ripgrep \
        tree \
        xclip \
        coreutils \
        findutils \
        tar \
        unzip \
        openssl \
        gzip \
        xz \
        bzip2 \
        poppler-utils \
        ffmpeg \
        imagemagick \
        file \
        zip \
        dos2unix \
        ca-certificates \
        patch \
        shellcheck \
        yamllint \
        bind-tools \
        procps \
        netcat-openbsd \
        util-linux \
        which \
        diffutils \
        buildkit \
        moreutils \
        libnotify \
        semodule-utils \
        checkpolicy@edge-testing \
        github-cli

RUN set -eux; \
    bundle="docker-helper-${DOCKER_HELPER_VERSION}-linux-amd64"; \
    archive="/tmp/${bundle}.tar.gz"; \
    \
    curl -fsSL --retry 3 \
      "https://github.com/kivarun/docker-helper/releases/download/v${DOCKER_HELPER_VERSION}/${bundle}.tar.gz" \
      -o "${archive}"; \
    \
    echo "${DOCKER_HELPER_SHA256}  ${archive}" | sha256sum -c -; \
    \
    tar -xzf "${archive}" -C /tmp; \
    \
    install -m 0755 \
      "/tmp/${bundle}/docker-helper" \
      /usr/local/bin/docker-helper; \
    \
    install -d \
      -m 0700 \
      -o opencode \
      -g opencode \
      /home/opencode/.ssh; \
    \
    install -d \
      -m 0755 \
      -o opencode \
      -g opencode \
      /home/opencode/.claude/skills/docker-helper; \
    \
    install \
      -m 0644 \
      -o opencode \
      -g opencode \
      "/tmp/${bundle}/skills/docker-helper/SKILL.md" \
      /home/opencode/.claude/skills/docker-helper/SKILL.md; \
    \
    test "$(docker-helper version)" = "${DOCKER_HELPER_VERSION}"; \
    \
    rm -rf "${archive}" "/tmp/${bundle}"

USER opencode
