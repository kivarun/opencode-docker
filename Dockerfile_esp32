# syntax=docker/dockerfile:1
# ci: standalone
#
# OpenCode worker for ESP32-S3 / XTEINK X4 Classic firmware development.
# Build-only container: never pass /dev/ttyACM*, USB/JTAG or docker.sock to it.
# The FreeInk SDK and firmware source belong to the separate x4-classic-lab repo.

FROM debian:bookworm-slim

ARG TARGETARCH
ARG OPENCODE_VERSION=1.18.32
ARG OPENCODE_SHA256=3046e0404fdc60fb80307e7a47824ba07477364178a4d09baa8548496dd6d43b
ARG DOCKER_HELPER_VERSION=2.3.0
ARG DOCKER_HELPER_SHA256=e2a24a7d01025a9d1269b8edbea7a2d94607efec08a06f5a93935b20d141a0f1
ARG PLATFORMIO_VERSION=6.1.19
ARG ESPTOOL_VERSION=5.3.1
ARG PIOARDUINO_PLATFORM_URL=https://github.com/pioarduino/platform-espressif32/releases/download/55.03.37/platform-espressif32.zip

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/esp32-venv \
    PATH=/opt/esp32-venv/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The pinned OpenCode and docker-helper assets below are linux-amd64.
RUN test "${TARGETARCH:-amd64}" = amd64

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        cmake \
        coreutils \
        curl \
        diffutils \
        fd-find \
        file \
        findutils \
        git \
        gnupg \
        gzip \
        jq \
        less \
        libffi-dev \
        libssl-dev \
        libudev1 \
        libusb-1.0-0 \
        make \
        nano \
        ninja-build \
        openssh-client \
        patch \
        pkg-config \
        procps \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        ripgrep \
        rsync \
        tar \
        tree \
        unzip \
        xz-utils \
        zip \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# PlatformIO/pioarduino build environment and offline esptool image inspection.
# Firmware projects pin their own platform= URL and library revisions.
RUN python3 -m venv "${VIRTUAL_ENV}" \
    && python -m pip install --no-cache-dir --disable-pip-version-check \
        "platformio==${PLATFORMIO_VERSION}" \
        "esptool==${ESPTOOL_VERSION}" \
    && pio --version \
    && esptool version

# Install an exact, checksum-verified upstream OpenCode release; no curl | bash.
RUN set -eux; \
    archive=/tmp/opencode.tar.gz; \
    curl -fsSL --retry 3 \
      "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-linux-x64.tar.gz" \
      -o "${archive}"; \
    echo "${OPENCODE_SHA256}  ${archive}" | sha256sum -c -; \
    mkdir /tmp/opencode-unpack; \
    tar -xzf "${archive}" -C /tmp/opencode-unpack; \
    binary="$(find /tmp/opencode-unpack -type f -name opencode -print -quit)"; \
    test -n "${binary}"; \
    install -m 0755 "${binary}" /usr/local/bin/opencode; \
    opencode --version; \
    rm -rf "${archive}" /tmp/opencode-unpack

# Match the helper client used by the current opencode-docker base image.
# The helper daemon and Principal/Launcher credentials remain on the host.
RUN set -eux; \
    bundle="docker-helper-${DOCKER_HELPER_VERSION}-linux-amd64"; \
    archive="/tmp/${bundle}.tar.gz"; \
    curl -fsSL --retry 3 \
      "https://github.com/kivarun/docker-helper/releases/download/v${DOCKER_HELPER_VERSION}/${bundle}.tar.gz" \
      -o "${archive}"; \
    echo "${DOCKER_HELPER_SHA256}  ${archive}" | sha256sum -c -; \
    tar -xzf "${archive}" -C /tmp; \
    install -m 0755 "/tmp/${bundle}/docker-helper" /usr/local/bin/docker-helper; \
    install -d -m 0755 /opt/docker-helper-skill; \
    install -m 0644 "/tmp/${bundle}/skills/docker-helper/SKILL.md" /opt/docker-helper-skill/SKILL.md; \
    test "$(docker-helper version)" = "${DOCKER_HELPER_VERSION}"; \
    rm -rf "${archive}" "/tmp/${bundle}"

RUN groupadd --gid 1000 opencode \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash opencode \
    && install -d -m 0755 -o opencode -g opencode \
        /workspace \
        /home/opencode/.config \
        /home/opencode/.config/opencode \
        /home/opencode/.local \
        /home/opencode/.local/share \
        /home/opencode/.local/share/opencode \
        /home/opencode/.local/state \
        /home/opencode/.cache \
        /home/opencode/.platformio \
    && install -d -m 0700 -o opencode -g opencode /home/opencode/.ssh \
    && install -d -m 0755 -o opencode -g opencode \
        /home/opencode/.claude/skills/docker-helper \
    && install -m 0644 -o opencode -g opencode \
        /opt/docker-helper-skill/SKILL.md \
        /home/opencode/.claude/skills/docker-helper/SKILL.md

ENV HOME=/home/opencode \
    PLATFORMIO_CORE_DIR=/home/opencode/.platformio

# OpenCode global permission config: deterministic read-only access to the
# pre-installed ESP32 toolchain (the pip venv and the PlatformIO core dir)
# without opening the rest of the filesystem. opencode evaluates permission
# patterns with the LAST matching rule winning, so the broad deny is listed
# first and the two tool roots after it: every path outside the workspace
# stays denied for external access (no permission prompts, headless runs
# included), both tool roots stay readable by the read/grep/glob tools, and
# the edit tool is explicitly denied on both roots. The edit tool submits
# out-of-worktree paths as worktree-relative strings (`../home/...`), so the
# deny list carries the absolute forms and wildcard forms that also match
# those relative submissions (the absolute forms stay inert for an absolute
# submission or a future opencode that matches absolutes). The hard write
# boundary is the Unix permissions: /opt/esp32-venv is root-owned (opencode
# cannot write it at all), while /home/opencode/.platformio must stay
# user-owned for PlatformIO build operations (package installs, platform
# caches) — the edit deny covers OpenCode's file-editing tools; `pio` runs
# through bash and keeps working. A per-profile OPENCODE_CONFIG_CONTENT
# merge that does not redefine `permission` leaves these rules in effect.
RUN set -eux; \
    install -m 0644 -o opencode -g opencode /dev/null /home/opencode/.config/opencode/opencode.json; \
    printf '%s\n' \
        '{' \
        '  "$schema": "https://opencode.ai/config.json",' \
        '  "permission": {' \
        '    "external_directory": {' \
        '      "*": "deny",' \
        '      "/opt/esp32-venv/**": "allow",' \
        '      "/home/opencode/.platformio/**": "allow"' \
        '    },' \
        '    "edit": {' \
        '      "*": "allow",' \
        '      "/opt/esp32-venv/**": "deny",' \
        '      "/home/opencode/.platformio/**": "deny",' \
        '      "**/opt/esp32-venv/**": "deny",' \
        '      "**/.platformio/**": "deny"' \
        '    }' \
        '  }' \
        '}' > /home/opencode/.config/opencode/opencode.json

USER opencode
WORKDIR /workspace

# Pre-install the exact pioarduino platform specified by FreeInk's x4c sample.
# This caches the framework/toolchain in a user-writable PlatformIO directory.
RUN pio pkg install --global --platform "${PIOARDUINO_PLATFORM_URL}" \
    && pio pkg list --global --only-platforms \
    && test -w "${PLATFORMIO_CORE_DIR}"

# pioarduino 55.03.37 bug fix (upstream fragment: builder/penv_setup.py in
# the platform zip pinned by PIOARDUINO_PLATFORM_URL). The script installs
# the PlatformIO CLI from the pinned pioarduino platformio-core v6.1.19
# URL, but that distribution registers as "pioarduino-core" (upstream
# setup.py: name = __title__ = "pioarduino core"), while the dependency
# check looks up only the "platformio" key. Every networked project build
# therefore treats the CLI as missing and re-resolves the URL package - an
# unnecessary download that x4-classic-lab currently works around with
# scripts/build_offline.sh. Minimal upstream-targeted fix, not a separate
# package-manager implementation: the installed "pioarduino-core" dist is
# normalised into the "platformio" key the check expects. The guard fails
# the build if the checked upstream fragment changed.
RUN set -eux; \
    penv_setup="${PLATFORMIO_CORE_DIR}/platforms/espressif32/builder/penv_setup.py"; \
    test -f "${penv_setup}"; \
    python3 - "${penv_setup}" <<'PYEOF'
import py_compile
import sys
path = sys.argv[1]
src = open(path, encoding="utf-8").read()
old = "    for package, spec in deps.items():\n"
new = (
    "    if \"platformio\" not in installed_packages and \"pioarduino-core\" in installed_packages:\n"
    "        installed_packages[\"platformio\"] = installed_packages[\"pioarduino-core\"]\n"
    "    for package, spec in deps.items():\n"
)
assert src.count(old) == 1, "unexpected upstream penv_setup.py change"
out = src.replace(old, new)
open(path, "w", encoding="utf-8").write(out)
assert out.count(new) == 1
py_compile.compile(path, doraise=True)
PYEOF

# Pre-warm the complete Arduino build environment for the exact X4 Classic
# target: fully compile a throwaway minimal project at image build time
# (esp32-s3-devkitc1-n16r8: 16 MB DIO flash + 8 MB OPI PSRAM, Arduino
# framework, resolved from the same pinned pioarduino platform URL as
# FreeInk's x4c sample). This downloads the platform from that URL, the
# Arduino core, the Xtensa toolchain and every other required package into
# /home/opencode/.platformio. The FreeInk SDK itself is not included.
RUN set -eux; \
    proj=/tmp/prewarm-x4classic; \
    mkdir -p "${proj}/src"; \
    printf '%s\n' \
        '[env:prewarm]' \
        'board = esp32-s3-devkitc1-n16r8' \
        'framework = arduino' \
        'board_build.flash_mode = dio' \
        'board_build.psram_type = opi' \
        'board_upload.flash_size = 16MB' \
        > "${proj}/platformio.ini"; \
    printf 'platform = %s\n' "${PIOARDUINO_PLATFORM_URL}" >> "${proj}/platformio.ini"; \
    printf '%s\n' \
        '#include <Arduino.h>' \
        '' \
        'void setup() {}' \
        'void loop() {}' \
        > "${proj}/src/main.cpp"; \
    cd "${proj}" \
    && pio run

# Full rebuild in a fresh container with the network disabled: every RUN
# step is a fresh container and --network=none removes all network access,
# and the rebuild happens in place (no temporary overlay copy), so this
# proves the cached PlatformIO environment is complete for the exact X4
# Classic configuration, including the URL-based platform resolution.
RUN --network=none set -eux; \
    cd /tmp/prewarm-x4classic \
    && rm -rf .pio \
    && pio run

# Second offline rebuild after removing the project's .pio again.
# GITHUB_ACTIONS forces penv_setup.py to run its Python-dependency branch
# even without network (upstream skips that branch when its connection
# check fails), so with the penv_setup fix the install list is empty and
# no download is attempted; this step fails the build if the fix were
# missing.
RUN --network=none set -eux; \
    cd /tmp/prewarm-x4classic \
    && rm -rf .pio \
    && GITHUB_ACTIONS=1 pio run

# Remove the throwaway project; the PlatformIO cache stays.
RUN rm -rf /tmp/prewarm-x4classic

# Verify the installed versions and the OpenCode launch contract in a
# fresh container without network: `opencode -c --version` proves that
# launcher-appended arguments reach OpenCode itself instead of being
# exec'd as a program.
RUN --network=none set -eux; \
    pio --version \
    && esptool version \
    && opencode --version \
    && docker-helper version \
    && pio pkg list --global --only-platforms \
    && test "$(opencode -c --version)" = "$(opencode --version)"

# Regression: the baked OpenCode permission config grants read access to the
# installed toolchain roots without opening the rest of the filesystem, and
# denies OpenCode edits there. jq pins the exact rule set AND the rule order
# (opencode evaluates the LAST matching rule, so the broad deny must precede
# the tool-root allows), the file stays owned by opencode with a fixed mode,
# and `opencode debug config` proves OpenCode itself resolves the file
# cleanly with the rules surviving resolution.
RUN --network=none set -eux; \
    cfg=/home/opencode/.config/opencode/opencode.json; \
    test "$(stat -c '%U:%G %a' "${cfg}")" = "opencode:opencode 644"; \
    test "$(jq -r '."$schema"' "${cfg}")" = "https://opencode.ai/config.json"; \
    test "$(jq -c '.permission.external_directory | keys_unsorted' "${cfg}")" = '["*","/opt/esp32-venv/**","/home/opencode/.platformio/**"]'; \
    test "$(jq -r '.permission.external_directory["*"]' "${cfg}")" = "deny"; \
    test "$(jq -r '.permission.external_directory["/opt/esp32-venv/**"]' "${cfg}")" = "allow"; \
    test "$(jq -r '.permission.external_directory["/home/opencode/.platformio/**"]' "${cfg}")" = "allow"; \
    test "$(jq -c '.permission.edit | keys_unsorted' "${cfg}")" = '["*","/opt/esp32-venv/**","/home/opencode/.platformio/**","**/opt/esp32-venv/**","**/.platformio/**"]'; \
    test "$(jq -r '.permission.edit["*"]' "${cfg}")" = "allow"; \
    test "$(jq -r '.permission.edit["/opt/esp32-venv/**"]' "${cfg}")" = "deny"; \
    test "$(jq -r '.permission.edit["/home/opencode/.platformio/**"]' "${cfg}")" = "deny"; \
    test "$(jq -r '.permission.edit["**/opt/esp32-venv/**"]' "${cfg}")" = "deny"; \
    test "$(jq -r '.permission.edit["**/.platformio/**"]' "${cfg}")" = "deny"; \
    opencode debug config | jq -e '.permission.external_directory["/home/opencode/.platformio/**"] == "allow" and .permission.external_directory["*"] == "deny" and .permission.edit["/opt/esp32-venv/**"] == "deny"' > /dev/null

# Launch contract: the launcher's container command list is appended to
# the ENTRYPOINT, so `oc-esp32 -c` runs OpenCode with the `-c`
# (continue-last-session) argument instead of trying to exec "-c" as a
# program (the former CMD ["opencode"] form). The orchestrator's worker
# launcher overrides the entrypoint explicitly with --entrypoint
# opencode, so this stays compatible with it.
ENTRYPOINT ["opencode"]
