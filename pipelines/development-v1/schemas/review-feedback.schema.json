{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development pipeline reviewer feedback",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "issues"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "severity", "description"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": ["major", "minor"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
